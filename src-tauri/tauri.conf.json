{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitpuake",
  "version": "0.1.0",
  "identifier": "dev.atma.gitpuake",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitpuake",
        "width": 1400,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Atma-Dev",
    "category": "DeveloperTool",
    "shortDescription": "Git client desktop ala GitKraken",
    "longDescription": "gitpuake adalah git client desktop ala GitKraken (Tauri 2 + Vue 3): commit graph, stage per hunk/baris, interactive rebase, editor merge conflict, dan Pull Request GitHub. Menjalankan git CLI yang terpasang.",
    "linux": {
      "deb": { "depends": ["git"] },
      "rpm": { "depends": ["git"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
